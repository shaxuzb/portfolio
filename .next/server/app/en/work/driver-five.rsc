5:["$","main",null,{"children":[["$","$L12",null,{}],["$","$L13",null,{"project":{"slug":"driver-five","name":"Driver Five","kind":"mobile","category":{"en":"Mobile app · Taxi drivers","ru":"Мобильное приложение · Водители такси","uz":"Mobil ilova · Taksi haydovchilari"},"title":{"en":"Driver app for a taxi company","ru":"Приложение водителя для таксопарка","uz":"Taksi kompaniyasi uchun haydovchi ilovasi"},"year":{"en":"Nov 2025 — Jun 2026","ru":"Ноя 2025 — Июн 2026","uz":"Noy 2025 — Iyun 2026"},"role":{"en":"Product Designer · Contract","ru":"Продуктовый дизайнер · Контракт","uz":"Product dizayner · Shartnoma"},"platform":{"en":"iOS & Android","ru":"iOS и Android","uz":"iOS va Android"},"scope":{"en":"170+ screens · Light & Dark","ru":"170+ экранов · Светлая и тёмная темы","uz":"170+ ekran · Yorug‘ va qorong‘i"},"summary":{"en":"Going online, accepting orders, the trip from pickup to drop-off, earnings and profile — in one clear scenario.","ru":"Выход на линию, приём заказа, поездка от подачи до высадки, заработок и профиль — в одном понятном сценарии.","uz":"Liniyaga chiqish, buyurtma qabul qilish, yo‘lovchini olishdan tushirishgacha bo‘lgan safar, daromad va profil — bitta tushunarli ssenariyda."},"description":{"en":"Designed from zero: a mobile app for taxi drivers that covers onboarding with document checks, going online, new orders, pickup and waiting, the trip and payment, the order feed, wallet and tariffs, and earnings history. I prepared interactive prototypes so the team could validate the scenarios before development started.","ru":"Спроектировал с нуля мобильное приложение водителя такси: онбординг с проверкой документов, выход на линию, новые заказы, подача и ожидание, поездка и оплата, лента заказов, кошелёк и тарифы, история заработка. Подготовил интерактивные прототипы — команда проверила сценарии до начала разработки.","uz":"Taksi haydovchilari uchun mobil ilovani noldan loyihaladim: hujjatlarni tekshirish bilan onboarding, liniyaga chiqish, yangi buyurtmalar, yo‘lovchini olish va kutish, safar va to‘lov, buyurtmalar lentasi, hamyon va tariflar, daromad tarixi. Interaktiv prototiplar tayyorladim — jamoa ssenariylarni ishlab chiqish boshlanishidan oldin tekshirdi."},"highlights":[{"en":"One continuous flow from going online to drop-off and payment","ru":"Единый сценарий от выхода на линию до высадки и оплаты","uz":"Liniyaga chiqishdan yo‘lovchini tushirish va to‘lovgacha yagona ssenariy"},{"en":"Onboarding with document upload and verification","ru":"Онбординг с загрузкой и проверкой документов","uz":"Hujjatlarni yuklash va tekshirish bilan onboarding"},{"en":"Earnings, wallet and tariffs drivers can read at a glance","ru":"Заработок, кошелёк и тарифы, понятные с первого взгляда","uz":"Bir qarashda tushunarli daromad, hamyon va tariflar"},{"en":"Interactive prototypes used to test scenarios before development","ru":"Интерактивные прототипы для проверки сценариев до разработки","uz":"Ssenariylarni ishlab chiqishdan oldin tekshirish uchun interaktiv prototiplar"}],"tags":["iOS","Android","Light & Dark","Prototyping"],"accent":"#8B6CFF","featured":true,"cover":{"src":"/work/driver/overview.webp","w":2400,"h":1350,"caption":{"en":"Driver Five — overview","ru":"Driver Five — обзор","uz":"Driver Five — umumiy ko‘rinish"}},"gallery":[{"src":"/work/driver/03-online.webp","w":2400,"h":1879,"caption":{"en":"Going online & new orders","ru":"Выход на линию и новые заказы","uz":"Liniyaga chiqish va yangi buyurtmalar"}},{"src":"/work/driver/05-trip.webp","w":2400,"h":2873,"caption":{"en":"Trip & payment","ru":"Поездка и оплата","uz":"Safar va to‘lov"}},{"src":"/work/driver/09-earnings.webp","w":2400,"h":2530,"caption":{"en":"Earnings & history","ru":"Заработок и история","uz":"Daromad va tarix"}}]},"next":{"slug":"uysot-dashboard","name":"UYSOT Dashboard","kind":"saas","category":{"en":"SaaS · Analytics","ru":"SaaS · Аналитика","uz":"SaaS · Analitika"},"title":{"en":"Customizable sales & marketing dashboards","ru":"Настраиваемые дашборды продаж и маркетинга","uz":"Sozlanadigan savdo va marketing dashboardlari"},"year":{"en":"2023 — present","ru":"2023 — н.в.","uz":"2023 — hozir"},"role":{"en":"Product Designer","ru":"Продуктовый дизайнер","uz":"Product dizayner"},"platform":{"en":"Web & mobile","ru":"Веб и мобайл","uz":"Veb va mobil"},"scope":{"en":"Widget library · Funnels","ru":"Библиотека виджетов · Воронки","uz":"Vidjetlar kutubxonasi · Voronkalar"},"summary":{"en":"Sales and marketing dashboards for real-estate developers, assembled from a responsive widget library.","ru":"Дашборды продаж и маркетинга для девелоперов, собранные из адаптивной библиотеки виджетов.","uz":"Developerlar uchun moslashuvchan vidjetlar kutubxonasidan yig‘iladigan savdo va marketing dashboardlari."},"description":{"en":"Managers build their own dashboard pages from a library of widgets — KPIs, funnels, campaign breakdowns and conversion trends. The widgets are designed once and adapt to any grid size and to mobile.","ru":"Менеджеры сами собирают страницы дашбордов из библиотеки виджетов — KPI, воронки, разбивка по кампаниям и динамика конверсии. Виджеты спроектированы один раз и адаптируются к любой сетке и к мобайлу.","uz":"Menejerlar dashboard sahifalarini vidjetlar kutubxonasidan o‘zlari yig‘adi — KPI, voronkalar, kampaniyalar kesimi va konversiya dinamikasi. Vidjetlar bir marta loyihalangan va istalgan to‘r o‘lchamiga hamda mobilga moslashadi."},"highlights":[{"en":"Sales dashboards with KPIs, funnels and conversion over time","ru":"Дашборды продаж: KPI, воронки и динамика конверсии","uz":"Savdo dashboardlari: KPI, voronkalar va konversiya dinamikasi"},{"en":"Editable dashboard pages managers assemble themselves","ru":"Редактируемые страницы, которые менеджеры собирают сами","uz":"Menejerlar o‘zlari yig‘adigan tahrirlanuvchi sahifalar"},{"en":"Responsive widget library that scales from desktop to mobile","ru":"Адаптивная библиотека виджетов — от десктопа до мобайла","uz":"Desktopdan mobilgacha moslashuvchan vidjetlar kutubxonasi"}],"tags":["Web app","Analytics","Widgets"],"accent":"#34C38F","cover":{"src":"/work/dashboard/overview.webp","w":2400,"h":1350,"caption":{"en":"UYSOT Dashboard — overview","ru":"UYSOT Dashboard — обзор","uz":"UYSOT Dashboard — umumiy ko‘rinish"}},"gallery":[{"src":"/work/dashboard/01-sales.webp","w":2400,"h":1808,"caption":{"en":"Sales dashboards","ru":"Дашборды продаж","uz":"Savdo dashboardlari"}},{"src":"/work/dashboard/04-widgets.webp","w":2400,"h":1961,"caption":{"en":"Widget library","ru":"Библиотека виджетов","uz":"Vidjetlar kutubxonasi"}}]}}],"$L14"]}]
