5:["$","main",null,{"children":[["$","$L12",null,{}],["$","$L13",null,{"project":{"slug":"jamal","name":"JAMAL.UZ","kind":"saas","category":{"en":"Admin panel · Inventory & sales","ru":"Админ-панель · Склад и продажи","uz":"Admin panel · Ombor va savdo"},"title":{"en":"Web and mobile admin for a trading business","ru":"Веб- и мобильная админка для торговой компании","uz":"Savdo kompaniyasi uchun veb va mobil admin panel"},"year":{"en":"","ru":"","uz":""},"role":{"en":"Product Designer","ru":"Продуктовый дизайнер","uz":"Product dizayner"},"platform":{"en":"Web & mobile","ru":"Веб и мобайл","uz":"Veb va mobil"},"scope":{"en":"Light & Dark","ru":"Светлая и тёмная темы","uz":"Yorug‘ va qorong‘i mavzu"},"summary":{"en":"Products, inventory counts, sales, reports and directories — on web and mobile, in light and dark.","ru":"Товары, инвентаризация, продажи, отчёты и справочники — на вебе и мобайле, в светлой и тёмной темах.","uz":"Mahsulotlar, inventarizatsiya, savdo, hisobotlar va ma’lumotnomalar — veb va mobilda, yorug‘ va qorong‘i mavzuda."},"description":{"en":"An admin system for a trading company: product catalog and inventory, warehouses and suppliers, sales, clients and users, and reports — with dense data tables that stay readable in both themes and a mobile version for working on the go.","ru":"Админ-система для торговой компании: каталог товаров и инвентаризация, склады и поставщики, продажи, клиенты и пользователи, отчёты. Плотные таблицы остаются читаемыми в обеих темах, а мобильная версия позволяет работать на ходу.","uz":"Savdo kompaniyasi uchun admin tizim: mahsulotlar katalogi va inventarizatsiya, omborlar va yetkazib beruvchilar, savdo, mijozlar va foydalanuvchilar, hisobotlar. Zich jadvallar ikkala mavzuda ham o‘qilishi oson, mobil versiya esa yo‘lda ishlash imkonini beradi."},"highlights":[{"en":"Data-heavy tables for products, stock and sales","ru":"Плотные таблицы товаров, остатков и продаж","uz":"Mahsulotlar, qoldiqlar va savdo uchun zich jadvallar"},{"en":"Reports with filters across warehouses, suppliers and sellers","ru":"Отчёты с фильтрами по складам, поставщикам и продавцам","uz":"Omborlar, yetkazib beruvchilar va sotuvchilar bo‘yicha filtrli hisobotlar"},{"en":"Mobile app for checking stock on the go","ru":"Мобильное приложение для проверки остатков на ходу","uz":"Qoldiqlarni yo‘lda tekshirish uchun mobil ilova"}],"tags":["Web","Mobile","Inventory"],"accent":"#7A6BFF","cover":{"src":"/work/jamal/overview.webp","w":2400,"h":1350,"caption":{"en":"JAMAL.UZ — overview","ru":"JAMAL.UZ — обзор","uz":"JAMAL.UZ — umumiy ko‘rinish"}},"gallery":[{"src":"/work/jamal/02-reports.webp","w":2400,"h":1566,"caption":{"en":"Reports","ru":"Отчёты","uz":"Hisobotlar"}},{"src":"/work/jamal/04-sales.webp","w":2400,"h":1269,"caption":{"en":"Sales","ru":"Продажи","uz":"Savdo"}}]},"next":{"slug":"ticher","name":"TICHER","kind":"mobile","category":{"en":"Mobile app · EdTech for parents","ru":"Мобильное приложение · EdTech для родителей","uz":"Mobil ilova · Ota-onalar uchun EdTech"},"title":{"en":"A school app for parents","ru":"Школьное приложение для родителей","uz":"Ota-onalar uchun maktab ilovasi"},"year":{"en":"","ru":"","uz":""},"role":"$5:props:children:1:props:project:role","platform":{"en":"iOS & Android","ru":"iOS и Android","uz":"iOS va Android"},"scope":{"en":"30+ screens","ru":"30+ экранов","uz":"30+ ekran"},"summary":{"en":"The child's test results, attendance, grades and behavior, reports, teacher chat, meetings and a premium plan.","ru":"Результаты тестов ребёнка, посещаемость, оценки и поведение, отчёты, чат с учителем, встречи и премиум-тариф.","uz":"Farzandning test natijalari, davomati, baholari va xulqi, hisobotlar, o‘qituvchi bilan chat, uchrashuvlar va premium tarif."},"description":{"en":"TICHER keeps parents close to their child's school life: test results and ratings, activity and attendance, reports and parent–teacher meetings, chat and a premium subscription.","ru":"TICHER помогает родителям быть ближе к школьной жизни ребёнка: результаты тестов и рейтинг, активность и посещаемость, отчёты и встречи с учителем, чат и премиум-подписка.","uz":"TICHER ota-onalarni farzandining maktab hayotiga yaqinlashtiradi: test natijalari va reyting, faollik va davomat, hisobotlar va o‘qituvchi bilan uchrashuvlar, chat va premium obuna."},"highlights":[{"en":"Test results and ratings parents understand at a glance","ru":"Результаты тестов и рейтинг, понятные с первого взгляда","uz":"Bir qarashda tushunarli test natijalari va reyting"},{"en":"Weekly and monthly activity statistics","ru":"Статистика активности за неделю и месяц","uz":"Haftalik va oylik faollik statistikasi"},{"en":"Teacher chat, meetings and notifications","ru":"Чат с учителем, встречи и уведомления","uz":"O‘qituvchi bilan chat, uchrashuvlar va bildirishnomalar"}],"tags":["iOS","Android","EdTech"],"accent":"#2F7BFF","cover":{"src":"/work/ticher/overview.webp","w":2400,"h":1350,"caption":{"en":"TICHER — overview","ru":"TICHER — обзор","uz":"TICHER — umumiy ko‘rinish"}},"gallery":[{"src":"/work/ticher/01-home.webp","w":2400,"h":2109,"caption":{"en":"Sign-in & home","ru":"Вход и главная","uz":"Kirish va bosh sahifa"}},{"src":"/work/ticher/02-results.webp","w":2400,"h":1053,"caption":{"en":"Learning results","ru":"Результаты обучения","uz":"O‘qish natijalari"}}]}}],"$L14"]}]
