5:["$","main",null,{"children":[["$","$L12",null,{}],["$","$L13",null,{"project":{"slug":"uyim","name":"UYIM","kind":"mobile","category":{"en":"Mobile app · Property owners","ru":"Мобильное приложение · Владельцы квартир","uz":"Mobil ilova · Kvartira egalari"},"title":{"en":"The apartment buyer's app","ru":"Приложение для покупателей квартир","uz":"Kvartira xaridorlari uchun ilova"},"year":{"en":"2023 — present","ru":"2023 — н.в.","uz":"2023 — hozir"},"role":{"en":"Product Designer","ru":"Продуктовый дизайнер","uz":"Product dizayner"},"platform":{"en":"iOS & Android","ru":"iOS и Android","uz":"iOS va Android"},"scope":{"en":"130 screens","ru":"130 экранов","uz":"130 ta ekran"},"summary":{"en":"Pay instalments, manage contracts, follow construction progress, resell the apartment and design its interior with AI.","ru":"Оплата рассрочки, договоры, ход строительства, перепродажа квартиры и дизайн интерьера с помощью ИИ.","uz":"Muddatli to‘lov, shartnomalar, qurilish jarayoni, kvartirani qayta sotish va AI yordamida interyer dizayni."},"description":{"en":"UYIM is the buyer-facing app of the UYSOT ecosystem. The home screen puts the amount due, stories and quick actions up front; around it sit payments, contracts, cards, live construction progress, market price, resale, new buildings and an AI interior designer. Every flow ships with its states — paid, overdue, failed, in two languages.","ru":"UYIM — приложение экосистемы UYSOT для покупателей. На главном экране — сумма к оплате, сторис и быстрые действия; вокруг — платежи, договоры, карты, ход строительства в реальном времени, рыночная стоимость, перепродажа, новостройки и ИИ-дизайн интерьера. Каждый сценарий передаётся со всеми состояниями — оплачено, просрочено, ошибка — на двух языках.","uz":"UYIM — UYSOT ekotizimining xaridorlar uchun ilovasi. Bosh ekranda to‘lov summasi, storislar va tezkor amallar; atrofida — to‘lovlar, shartnomalar, kartalar, jonli qurilish jarayoni, bozor narxi, qayta sotish, yangi binolar va AI interyer dizayni. Har bir ssenariy barcha holatlari bilan — to‘langan, kechikkan, xatolik — ikki tilda topshiriladi."},"highlights":[{"en":"Instalment payments with clear due, paid and failed states","ru":"Оплата рассрочки с понятными состояниями: к оплате, оплачено, ошибка","uz":"To‘lanishi kerak, to‘langan va xatolik holatlari aniq ko‘rinadigan muddatli to‘lovlar"},{"en":"Live construction progress with camera feed and photo reports","ru":"Ход строительства в реальном времени: камера и фотоотчёты","uz":"Kamera va fotohisobotlar bilan jonli qurilish jarayoni"},{"en":"Resale and market-price tracking for the buyer's apartment","ru":"Перепродажа и отслеживание рыночной стоимости квартиры","uz":"Kvartirani qayta sotish va bozor narxini kuzatish"},{"en":"AI interior design that generates room variants and a renovation estimate","ru":"ИИ-дизайн интерьера: варианты комнат и смета на ремонт","uz":"AI interyer dizayni: xona variantlari va ta’mirlash smetasi"}],"tags":["iOS","Android","Fintech","AI"],"accent":"#2E9BFF","featured":true,"cover":{"src":"/work/uyim/overview.webp","w":2400,"h":1350,"caption":{"en":"UYIM — overview","ru":"UYIM — обзор","uz":"UYIM — umumiy ko‘rinish"}},"gallery":[{"src":"/work/uyim/02-home.webp","w":2400,"h":1824,"caption":{"en":"Home & notifications","ru":"Главная и уведомления","uz":"Bosh sahifa va bildirishnomalar"}},{"src":"/work/uyim/04-payments.webp","w":2400,"h":1675,"caption":{"en":"Payments","ru":"Платежи","uz":"To‘lovlar"}},{"src":"/work/uyim/08-construction.webp","w":2400,"h":922,"caption":{"en":"Construction progress","ru":"Ход строительства","uz":"Qurilish jarayoni"}},{"src":"/work/uyim/12-ai.webp","w":2400,"h":824,"caption":{"en":"AI interior design","ru":"ИИ-дизайн интерьера","uz":"AI interyer dizayni"}},{"src":"/work/uyim/01-signin.webp","w":2400,"h":694,"caption":{"en":"Sign-in & onboarding","ru":"Вход и онбординг","uz":"Kirish va onboarding"}}]},"next":{"slug":"driver-five","name":"Driver Five","kind":"mobile","category":{"en":"Mobile app · Taxi drivers","ru":"Мобильное приложение · Водители такси","uz":"Mobil ilova · Taksi haydovchilari"},"title":{"en":"Driver app for a taxi company","ru":"Приложение водителя для таксопарка","uz":"Taksi kompaniyasi uchun haydovchi ilovasi"},"year":{"en":"Nov 2025 — Jun 2026","ru":"Ноя 2025 — Июн 2026","uz":"Noy 2025 — Iyun 2026"},"role":{"en":"Product Designer · Contract","ru":"Продуктовый дизайнер · Контракт","uz":"Product dizayner · Shartnoma"},"platform":"$5:props:children:1:props:project:platform","scope":{"en":"170+ screens · Light & Dark","ru":"170+ экранов · Светлая и тёмная темы","uz":"170+ ekran · Yorug‘ va qorong‘i"},"summary":{"en":"Going online, accepting orders, the trip from pickup to drop-off, earnings and profile — in one clear scenario.","ru":"Выход на линию, приём заказа, поездка от подачи до высадки, заработок и профиль — в одном понятном сценарии.","uz":"Liniyaga chiqish, buyurtma qabul qilish, yo‘lovchini olishdan tushirishgacha bo‘lgan safar, daromad va profil — bitta tushunarli ssenariyda."},"description":{"en":"Designed from zero: a mobile app for taxi drivers that covers onboarding with document checks, going online, new orders, pickup and waiting, the trip and payment, the order feed, wallet and tariffs, and earnings history. I prepared interactive prototypes so the team could validate the scenarios before development started.","ru":"Спроектировал с нуля мобильное приложение водителя такси: онбординг с проверкой документов, выход на линию, новые заказы, подача и ожидание, поездка и оплата, лента заказов, кошелёк и тарифы, история заработка. Подготовил интерактивные прототипы — команда проверила сценарии до начала разработки.","uz":"Taksi haydovchilari uchun mobil ilovani noldan loyihaladim: hujjatlarni tekshirish bilan onboarding, liniyaga chiqish, yangi buyurtmalar, yo‘lovchini olish va kutish, safar va to‘lov, buyurtmalar lentasi, hamyon va tariflar, daromad tarixi. Interaktiv prototiplar tayyorladim — jamoa ssenariylarni ishlab chiqish boshlanishidan oldin tekshirdi."},"highlights":[{"en":"One continuous flow from going online to drop-off and payment","ru":"Единый сценарий от выхода на линию до высадки и оплаты","uz":"Liniyaga chiqishdan yo‘lovchini tushirish va to‘lovgacha yagona ssenariy"},{"en":"Onboarding with document upload and verification","ru":"Онбординг с загрузкой и проверкой документов","uz":"Hujjatlarni yuklash va tekshirish bilan onboarding"},{"en":"Earnings, wallet and tariffs drivers can read at a glance","ru":"Заработок, кошелёк и тарифы, понятные с первого взгляда","uz":"Bir qarashda tushunarli daromad, hamyon va tariflar"},{"en":"Interactive prototypes used to test scenarios before development","ru":"Интерактивные прототипы для проверки сценариев до разработки","uz":"Ssenariylarni ishlab chiqishdan oldin tekshirish uchun interaktiv prototiplar"}],"tags":["iOS","Android","Light & Dark","Prototyping"],"accent":"#8B6CFF","featured":true,"cover":{"src":"/work/driver/overview.webp","w":2400,"h":1350,"caption":{"en":"Driver Five — overview","ru":"Driver Five — обзор","uz":"Driver Five — umumiy ko‘rinish"}},"gallery":[{"src":"/work/driver/03-online.webp","w":2400,"h":1879,"caption":{"en":"Going online & new orders","ru":"Выход на линию и новые заказы","uz":"Liniyaga chiqish va yangi buyurtmalar"}},{"src":"/work/driver/05-trip.webp","w":2400,"h":2873,"caption":{"en":"Trip & payment","ru":"Поездка и оплата","uz":"Safar va to‘lov"}},{"src":"/work/driver/09-earnings.webp","w":2400,"h":2530,"caption":{"en":"Earnings & history","ru":"Заработок и история","uz":"Daromad va tarix"}}]}}],"$L14"]}]
