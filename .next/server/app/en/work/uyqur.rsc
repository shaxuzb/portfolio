5:["$","main",null,{"children":[["$","$L12",null,{}],["$","$L13",null,{"project":{"slug":"uyqur","name":"UYQUR","kind":"saas","category":{"en":"SaaS · Construction ERP","ru":"SaaS · Строительная ERP","uz":"SaaS · Qurilish ERP"},"title":{"en":"All-in-one platform for construction companies","ru":"Единая платформа для строительных компаний","uz":"Qurilish kompaniyalari uchun yagona platforma"},"year":{"en":"2024 — present","ru":"2024 — н.в.","uz":"2024 — hozir"},"role":{"en":"Product Designer","ru":"Продуктовый дизайнер","uz":"Product dizayner"},"platform":{"en":"Web app","ru":"Веб-приложение","uz":"Veb-ilova"},"scope":{"en":"16 modules · AI assistant","ru":"16 модулей · ИИ-ассистент","uz":"16 modul · AI yordamchi"},"summary":{"en":"Estimates, supply and tenders, cash, warehouse, works and analytics for construction companies — in one web platform.","ru":"Сметы, снабжение и тендеры, касса, склад, работы и аналитика для строительных компаний — в одной веб-платформе.","uz":"Smetalar, ta’minot va tenderlar, kassa, ombor, ishlar va analitika — qurilish kompaniyalari uchun bitta veb-platformada."},"description":{"en":"UYQUR is a SaaS for managing construction projects. I own the product design end-to-end on web and mobile, turning dense business requirements into interfaces that people in very different roles — site managers, accountants, supply, owners — can work in every day. Each module is worked through for every role and edge case before it goes to development.","ru":"UYQUR — SaaS для управления строительными проектами. Веду дизайн продукта end-to-end на вебе и мобайле: превращаю сложные бизнес-требования в интерфейсы, в которых каждый день работают люди с очень разными ролями — прорабы, бухгалтеры, снабжение, владельцы. Каждый модуль прорабатываю под все роли и edge cases до передачи в разработку.","uz":"UYQUR — qurilish loyihalarini boshqarish uchun SaaS. Veb va mobilda mahsulot dizaynini boshidan oxirigacha olib boraman: murakkab biznes-talablarni turli roldagi odamlar — prorablar, buxgalterlar, ta’minotchilar, egalar — har kuni ishlaydigan interfeyslarga aylantiraman. Har bir modulni ishlab chiqishga berishdan oldin barcha rollar va edge case’lar bo‘yicha ishlab chiqaman."},"highlights":[{"en":"Translated complex business requirements into clear interfaces for multi-role teams","ru":"Перевёл сложные бизнес-требования в понятные интерфейсы для многоролевых команд","uz":"Murakkab biznes-talablarni ko‘p rolli jamoalar uchun tushunarli interfeyslarga aylantirdim"},{"en":"Designed 16 modules: projects, estimates, supply & tenders, cash, warehouse, contracts and more","ru":"Спроектировал 16 модулей: проекты, сметы, снабжение и тендеры, касса, склад, договоры и другие","uz":"16 ta modulni loyihaladim: loyihalar, smetalar, ta’minot va tenderlar, kassa, ombor, shartnomalar va boshqalar"},{"en":"Nura — an AI assistant built into the product","ru":"Nura — ИИ-ассистент внутри продукта","uz":"Nura — mahsulot ichidagi AI yordamchi"},{"en":"Moved web scenarios to mobile with the same logic, so the product works from a phone","ru":"Перенёс веб-сценарии на мобайл с единой логикой — с продуктом можно работать с телефона","uz":"Veb-ssenariylarni yagona mantiq bilan mobilga ko‘chirdim — mahsulot bilan telefondan ishlash mumkin"}],"tags":["Web app","ERP","Dashboards","AI"],"accent":"#6F7CFF","featured":true,"cover":{"src":"/work/uyqur/overview.webp","w":2400,"h":1350,"caption":{"en":"UYQUR — overview","ru":"UYQUR — обзор","uz":"UYQUR — umumiy ko‘rinish"}},"gallery":[{"src":"/work/uyqur/02-dashboards.webp","w":1800,"h":3988,"caption":{"en":"Dashboards","ru":"Дашборды","uz":"Dashboardlar"}},{"src":"/work/uyqur/03-projects.webp","w":2400,"h":1662,"caption":{"en":"Projects","ru":"Проекты","uz":"Loyihalar"}},{"src":"/work/uyqur/07-finance.webp","w":2400,"h":3262,"caption":{"en":"Cash & finance","ru":"Касса и финансы","uz":"Kassa va moliya"}},{"src":"/work/uyqur/13-ai.webp","w":2400,"h":2582,"caption":{"en":"Nura AI assistant","ru":"ИИ-ассистент Nura","uz":"Nura AI yordamchi"}}]},"next":{"slug":"uysot-crm","name":"UYSOT CRM","kind":"saas","category":{"en":"SaaS · Real-estate CRM","ru":"SaaS · CRM для недвижимости","uz":"SaaS · Ko‘chmas mulk CRM"},"title":{"en":"Sales CRM for real-estate developers","ru":"CRM продаж для девелоперов","uz":"Developerlar uchun savdo CRM tizimi"},"year":{"en":"2023 — present","ru":"2023 — н.в.","uz":"2023 — hozir"},"role":"$5:props:children:1:props:project:role","platform":"$5:props:children:1:props:project:platform","scope":{"en":"Pipeline · Automation · AI agents","ru":"Воронка · Автоматизация · ИИ-агенты","uz":"Voronka · Avtomatlashtirish · AI agentlar"},"summary":{"en":"Lead pipeline, call scripts, automation and AI agents that talk to clients — the sales core of the UYSOT ecosystem.","ru":"Воронка лидов, скрипты звонков, автоматизация и ИИ-агенты, которые общаются с клиентами, — ядро продаж экосистемы UYSOT.","uz":"Lidlar voronkasi, qo‘ng‘iroq skriptlari, avtomatlashtirish va mijozlar bilan gaplashadigan AI agentlar — UYSOT ekotizimining savdo yadrosi."},"description":{"en":"UYSOT is a software ecosystem for real-estate developers. I design its CRM alongside the mobile app and marketplace, keeping one UX approach across every product. The CRM interfaces were made consistent with the LUNAR design system I built from scratch, so new screens are assembled faster.","ru":"UYSOT — экосистема ПО для девелоперов недвижимости. Параллельно веду дизайн CRM, мобильного приложения и маркетплейса, сохраняя единый подход к UX во всех продуктах. Благодаря дизайн-системе LUNAR, которую я создал с нуля, интерфейсы CRM стали единообразными, а новые экраны собираются быстрее.","uz":"UYSOT — ko‘chmas mulk developerlari uchun dasturiy ekotizim. CRM, mobil ilova va marketpleys dizaynini parallel olib boraman va barcha mahsulotlarda yagona UX yondashuvini saqlayman. Noldan yaratgan LUNAR dizayn-tizimim tufayli CRM interfeyslari yagona ko‘rinishga keldi, yangi ekranlar esa tezroq yig‘iladi."},"highlights":[{"en":"Leads pipeline and a lead card that holds the full client history","ru":"Воронка лидов и карточка лида со всей историей клиента","uz":"Lidlar voronkasi va mijozning to‘liq tarixini saqlaydigan lid kartasi"},{"en":"No-code automation builder for routing and follow-ups","ru":"No-code конструктор автоматизаций для распределения и follow-up","uz":"Taqsimlash va follow-up uchun no-code avtomatlashtirish konstruktori"},{"en":"Call scripts, call-center widget and office meeting recording","ru":"Скрипты звонков, виджет колл-центра и запись встреч в офисе","uz":"Qo‘ng‘iroq skriptlari, call-markaz vidjeti va ofisdagi uchrashuvlarni yozib olish"},{"en":"Uysot AI agents that answer and qualify clients","ru":"ИИ-агенты Uysot AI, которые отвечают и квалифицируют клиентов","uz":"Mijozlarga javob beradigan va ularni saralaydigan Uysot AI agentlari"}],"tags":["Web app","CRM","Automation","AI"],"accent":"#2FBF71","featured":true,"cover":{"src":"/work/uysotcrm/overview.webp","w":2400,"h":1350,"caption":{"en":"UYSOT CRM — overview","ru":"UYSOT CRM — обзор","uz":"UYSOT CRM — umumiy ko‘rinish"}},"gallery":[{"src":"/work/uysotcrm/01-pipeline.webp","w":2400,"h":1664,"caption":{"en":"Leads pipeline","ru":"Воронка лидов","uz":"Lidlar voronkasi"}},{"src":"/work/uysotcrm/02-leadcard.webp","w":2400,"h":1579,"caption":{"en":"Lead card","ru":"Карточка лида","uz":"Lid kartasi"}},{"src":"/work/uysotcrm/07-ai.webp","w":2400,"h":2494,"caption":{"en":"Uysot AI","ru":"Uysot AI","uz":"Uysot AI"}}]}}],"$L14"]}]
