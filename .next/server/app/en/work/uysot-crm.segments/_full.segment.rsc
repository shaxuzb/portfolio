5:["$","main",null,{"children":[["$","$L12",null,{}],["$","$L13",null,{"project":{"slug":"uysot-crm","name":"UYSOT CRM","kind":"saas","category":{"en":"SaaS · Real-estate CRM","ru":"SaaS · CRM для недвижимости","uz":"SaaS · Ko‘chmas mulk CRM"},"title":{"en":"Sales CRM for real-estate developers","ru":"CRM продаж для девелоперов","uz":"Developerlar uchun savdo CRM tizimi"},"year":{"en":"2023 — present","ru":"2023 — н.в.","uz":"2023 — hozir"},"role":{"en":"Product Designer","ru":"Продуктовый дизайнер","uz":"Product dizayner"},"platform":{"en":"Web app","ru":"Веб-приложение","uz":"Veb-ilova"},"scope":{"en":"Pipeline · Automation · AI agents","ru":"Воронка · Автоматизация · ИИ-агенты","uz":"Voronka · Avtomatlashtirish · AI agentlar"},"summary":{"en":"Lead pipeline, call scripts, automation and AI agents that talk to clients — the sales core of the UYSOT ecosystem.","ru":"Воронка лидов, скрипты звонков, автоматизация и ИИ-агенты, которые общаются с клиентами, — ядро продаж экосистемы UYSOT.","uz":"Lidlar voronkasi, qo‘ng‘iroq skriptlari, avtomatlashtirish va mijozlar bilan gaplashadigan AI agentlar — UYSOT ekotizimining savdo yadrosi."},"description":{"en":"UYSOT is a software ecosystem for real-estate developers. I design its CRM alongside the mobile app and marketplace, keeping one UX approach across every product. The CRM interfaces were made consistent with the LUNAR design system I built from scratch, so new screens are assembled faster.","ru":"UYSOT — экосистема ПО для девелоперов недвижимости. Параллельно веду дизайн CRM, мобильного приложения и маркетплейса, сохраняя единый подход к UX во всех продуктах. Благодаря дизайн-системе LUNAR, которую я создал с нуля, интерфейсы CRM стали единообразными, а новые экраны собираются быстрее.","uz":"UYSOT — ko‘chmas mulk developerlari uchun dasturiy ekotizim. CRM, mobil ilova va marketpleys dizaynini parallel olib boraman va barcha mahsulotlarda yagona UX yondashuvini saqlayman. Noldan yaratgan LUNAR dizayn-tizimim tufayli CRM interfeyslari yagona ko‘rinishga keldi, yangi ekranlar esa tezroq yig‘iladi."},"highlights":[{"en":"Leads pipeline and a lead card that holds the full client history","ru":"Воронка лидов и карточка лида со всей историей клиента","uz":"Lidlar voronkasi va mijozning to‘liq tarixini saqlaydigan lid kartasi"},{"en":"No-code automation builder for routing and follow-ups","ru":"No-code конструктор автоматизаций для распределения и follow-up","uz":"Taqsimlash va follow-up uchun no-code avtomatlashtirish konstruktori"},{"en":"Call scripts, call-center widget and office meeting recording","ru":"Скрипты звонков, виджет колл-центра и запись встреч в офисе","uz":"Qo‘ng‘iroq skriptlari, call-markaz vidjeti va ofisdagi uchrashuvlarni yozib olish"},{"en":"Uysot AI agents that answer and qualify clients","ru":"ИИ-агенты Uysot AI, которые отвечают и квалифицируют клиентов","uz":"Mijozlarga javob beradigan va ularni saralaydigan Uysot AI agentlari"}],"tags":["Web app","CRM","Automation","AI"],"accent":"#2FBF71","featured":true,"cover":{"src":"/work/uysotcrm/overview.webp","w":2400,"h":1350,"caption":{"en":"UYSOT CRM — overview","ru":"UYSOT CRM — обзор","uz":"UYSOT CRM — umumiy ko‘rinish"}},"gallery":[{"src":"/work/uysotcrm/01-pipeline.webp","w":2400,"h":1664,"caption":{"en":"Leads pipeline","ru":"Воронка лидов","uz":"Lidlar voronkasi"}},{"src":"/work/uysotcrm/02-leadcard.webp","w":2400,"h":1579,"caption":{"en":"Lead card","ru":"Карточка лида","uz":"Lid kartasi"}},{"src":"/work/uysotcrm/07-ai.webp","w":2400,"h":2494,"caption":{"en":"Uysot AI","ru":"Uysot AI","uz":"Uysot AI"}}]},"next":{"slug":"uyim","name":"UYIM","kind":"mobile","category":{"en":"Mobile app · Property owners","ru":"Мобильное приложение · Владельцы квартир","uz":"Mobil ilova · Kvartira egalari"},"title":{"en":"The apartment buyer's app","ru":"Приложение для покупателей квартир","uz":"Kvartira xaridorlari uchun ilova"},"year":{"en":"2023 — present","ru":"2023 — н.в.","uz":"2023 — hozir"},"role":"$5:props:children:1:props:project:role","platform":{"en":"iOS & Android","ru":"iOS и Android","uz":"iOS va Android"},"scope":{"en":"130 screens","ru":"130 экранов","uz":"130 ta ekran"},"summary":{"en":"Pay instalments, manage contracts, follow construction progress, resell the apartment and design its interior with AI.","ru":"Оплата рассрочки, договоры, ход строительства, перепродажа квартиры и дизайн интерьера с помощью ИИ.","uz":"Muddatli to‘lov, shartnomalar, qurilish jarayoni, kvartirani qayta sotish va AI yordamida interyer dizayni."},"description":{"en":"UYIM is the buyer-facing app of the UYSOT ecosystem. The home screen puts the amount due, stories and quick actions up front; around it sit payments, contracts, cards, live construction progress, market price, resale, new buildings and an AI interior designer. Every flow ships with its states — paid, overdue, failed, in two languages.","ru":"UYIM — приложение экосистемы UYSOT для покупателей. На главном экране — сумма к оплате, сторис и быстрые действия; вокруг — платежи, договоры, карты, ход строительства в реальном времени, рыночная стоимость, перепродажа, новостройки и ИИ-дизайн интерьера. Каждый сценарий передаётся со всеми состояниями — оплачено, просрочено, ошибка — на двух языках.","uz":"UYIM — UYSOT ekotizimining xaridorlar uchun ilovasi. Bosh ekranda to‘lov summasi, storislar va tezkor amallar; atrofida — to‘lovlar, shartnomalar, kartalar, jonli qurilish jarayoni, bozor narxi, qayta sotish, yangi binolar va AI interyer dizayni. Har bir ssenariy barcha holatlari bilan — to‘langan, kechikkan, xatolik — ikki tilda topshiriladi."},"highlights":[{"en":"Instalment payments with clear due, paid and failed states","ru":"Оплата рассрочки с понятными состояниями: к оплате, оплачено, ошибка","uz":"To‘lanishi kerak, to‘langan va xatolik holatlari aniq ko‘rinadigan muddatli to‘lovlar"},{"en":"Live construction progress with camera feed and photo reports","ru":"Ход строительства в реальном времени: камера и фотоотчёты","uz":"Kamera va fotohisobotlar bilan jonli qurilish jarayoni"},{"en":"Resale and market-price tracking for the buyer's apartment","ru":"Перепродажа и отслеживание рыночной стоимости квартиры","uz":"Kvartirani qayta sotish va bozor narxini kuzatish"},{"en":"AI interior design that generates room variants and a renovation estimate","ru":"ИИ-дизайн интерьера: варианты комнат и смета на ремонт","uz":"AI interyer dizayni: xona variantlari va ta’mirlash smetasi"}],"tags":["iOS","Android","Fintech","AI"],"accent":"#2E9BFF","featured":true,"cover":{"src":"/work/uyim/overview.webp","w":2400,"h":1350,"caption":{"en":"UYIM — overview","ru":"UYIM — обзор","uz":"UYIM — umumiy ko‘rinish"}},"gallery":[{"src":"/work/uyim/02-home.webp","w":2400,"h":1824,"caption":{"en":"Home & notifications","ru":"Главная и уведомления","uz":"Bosh sahifa va bildirishnomalar"}},{"src":"/work/uyim/04-payments.webp","w":2400,"h":1675,"caption":{"en":"Payments","ru":"Платежи","uz":"To‘lovlar"}},{"src":"/work/uyim/08-construction.webp","w":2400,"h":922,"caption":{"en":"Construction progress","ru":"Ход строительства","uz":"Qurilish jarayoni"}},{"src":"/work/uyim/12-ai.webp","w":2400,"h":824,"caption":{"en":"AI interior design","ru":"ИИ-дизайн интерьера","uz":"AI interyer dizayni"}},{"src":"/work/uyim/01-signin.webp","w":2400,"h":694,"caption":{"en":"Sign-in & onboarding","ru":"Вход и онбординг","uz":"Kirish va onboarding"}}]}}],"$L14"]}]
