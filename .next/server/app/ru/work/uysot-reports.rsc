5:["$","main",null,{"children":[["$","$L12",null,{}],["$","$L13",null,{"project":{"slug":"uysot-reports","name":"UYSOT Reports","kind":"saas","category":{"en":"SaaS · Reporting","ru":"SaaS · Отчётность","uz":"SaaS · Hisobotlar"},"title":{"en":"No-code report builder for sales teams","ru":"No-code конструктор отчётов для отделов продаж","uz":"Savdo bo‘limlari uchun no-code hisobot konstruktori"},"year":{"en":"2023 — present","ru":"2023 — н.в.","uz":"2023 — hozir"},"role":{"en":"Product Designer","ru":"Продуктовый дизайнер","uz":"Product dizayner"},"platform":{"en":"Web app","ru":"Веб-приложение","uz":"Veb-ilova"},"scope":{"en":"Builder · Formulas · Plan vs. fact","ru":"Конструктор · Формулы · План/факт","uz":"Konstruktor · Formulalar · Reja/fakt"},"summary":{"en":"Custom columns, filters, formulas and plan-vs-fact tracking — reports without asking a developer.","ru":"Свои колонки, фильтры, формулы и план/факт — отчёты без помощи разработчика.","uz":"O‘z ustunlari, filtrlar, formulalar va reja/fakt — dasturchisiz hisobotlar."},"description":{"en":"Sales managers create their own reports: pick a data source, add columns and filters, write formulas and compare plan with fact per manager. The builder keeps a complex data model approachable for non-technical users.","ru":"Менеджеры продаж сами создают отчёты: выбирают источник данных, добавляют колонки и фильтры, пишут формулы и сравнивают план с фактом по каждому менеджеру. Конструктор делает сложную модель данных понятной для нетехнических пользователей.","uz":"Savdo menejerlari hisobotlarni o‘zlari yaratadi: ma’lumot manbasini tanlaydi, ustun va filtrlar qo‘shadi, formulalar yozadi va har bir menejer bo‘yicha rejani fakt bilan solishtiradi. Konstruktor murakkab ma’lumotlar modelini texnik bo‘lmagan foydalanuvchilar uchun tushunarli qiladi."},"highlights":[{"en":"Column builder with data sources, measures and filters","ru":"Конструктор колонок: источники данных, показатели и фильтры","uz":"Ustunlar konstruktori: ma’lumot manbalari, ko‘rsatkichlar va filtrlar"},{"en":"Formulas and grouping by manager or source","ru":"Формулы и группировка по менеджеру или источнику","uz":"Formulalar va menejer yoki manba bo‘yicha guruhlash"},{"en":"Plan vs. fact tables for sales teams","ru":"Таблицы план/факт для отделов продаж","uz":"Savdo bo‘limlari uchun reja/fakt jadvallari"}],"tags":["Web app","Reporting","Tables"],"accent":"#1FB5A0","cover":{"src":"/work/reports/overview.webp","w":2400,"h":1350,"caption":{"en":"UYSOT Reports — overview","ru":"UYSOT Reports — обзор","uz":"UYSOT Reports — umumiy ko‘rinish"}},"gallery":[{"src":"/work/reports/02-builder.webp","w":2400,"h":2168,"caption":{"en":"Custom report builder","ru":"Конструктор отчётов","uz":"Hisobot konstruktori"}}]},"next":{"slug":"jamal","name":"JAMAL.UZ","kind":"saas","category":{"en":"Admin panel · Inventory & sales","ru":"Админ-панель · Склад и продажи","uz":"Admin panel · Ombor va savdo"},"title":{"en":"Web and mobile admin for a trading business","ru":"Веб- и мобильная админка для торговой компании","uz":"Savdo kompaniyasi uchun veb va mobil admin panel"},"year":{"en":"","ru":"","uz":""},"role":"$5:props:children:1:props:project:role","platform":{"en":"Web & mobile","ru":"Веб и мобайл","uz":"Veb va mobil"},"scope":{"en":"Light & Dark","ru":"Светлая и тёмная темы","uz":"Yorug‘ va qorong‘i mavzu"},"summary":{"en":"Products, inventory counts, sales, reports and directories — on web and mobile, in light and dark.","ru":"Товары, инвентаризация, продажи, отчёты и справочники — на вебе и мобайле, в светлой и тёмной темах.","uz":"Mahsulotlar, inventarizatsiya, savdo, hisobotlar va ma’lumotnomalar — veb va mobilda, yorug‘ va qorong‘i mavzuda."},"description":{"en":"An admin system for a trading company: product catalog and inventory, warehouses and suppliers, sales, clients and users, and reports — with dense data tables that stay readable in both themes and a mobile version for working on the go.","ru":"Админ-система для торговой компании: каталог товаров и инвентаризация, склады и поставщики, продажи, клиенты и пользователи, отчёты. Плотные таблицы остаются читаемыми в обеих темах, а мобильная версия позволяет работать на ходу.","uz":"Savdo kompaniyasi uchun admin tizim: mahsulotlar katalogi va inventarizatsiya, omborlar va yetkazib beruvchilar, savdo, mijozlar va foydalanuvchilar, hisobotlar. Zich jadvallar ikkala mavzuda ham o‘qilishi oson, mobil versiya esa yo‘lda ishlash imkonini beradi."},"highlights":[{"en":"Data-heavy tables for products, stock and sales","ru":"Плотные таблицы товаров, остатков и продаж","uz":"Mahsulotlar, qoldiqlar va savdo uchun zich jadvallar"},{"en":"Reports with filters across warehouses, suppliers and sellers","ru":"Отчёты с фильтрами по складам, поставщикам и продавцам","uz":"Omborlar, yetkazib beruvchilar va sotuvchilar bo‘yicha filtrli hisobotlar"},{"en":"Mobile app for checking stock on the go","ru":"Мобильное приложение для проверки остатков на ходу","uz":"Qoldiqlarni yo‘lda tekshirish uchun mobil ilova"}],"tags":["Web","Mobile","Inventory"],"accent":"#7A6BFF","cover":{"src":"/work/jamal/overview.webp","w":2400,"h":1350,"caption":{"en":"JAMAL.UZ — overview","ru":"JAMAL.UZ — обзор","uz":"JAMAL.UZ — umumiy ko‘rinish"}},"gallery":[{"src":"/work/jamal/02-reports.webp","w":2400,"h":1566,"caption":{"en":"Reports","ru":"Отчёты","uz":"Hisobotlar"}},{"src":"/work/jamal/04-sales.webp","w":2400,"h":1269,"caption":{"en":"Sales","ru":"Продажи","uz":"Savdo"}}]}}],"$L14"]}]
