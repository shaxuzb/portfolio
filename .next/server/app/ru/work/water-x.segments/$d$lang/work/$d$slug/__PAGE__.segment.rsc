0:{"buildId":"vU1pkLWrlFyPJJi9EPQ4q","rsc":["$","$1","c",{"children":[["$","main",null,{"children":[["$","$L2",null,{}],["$","$L3",null,{"project":{"slug":"water-x","name":"Water X","kind":"mobile","category":{"en":"Mobile apps · Water delivery","ru":"Мобильные приложения · Доставка воды","uz":"Mobil ilovalar · Suv yetkazib berish"},"title":{"en":"Client and courier apps for water delivery","ru":"Клиентское и курьерское приложения для доставки воды","uz":"Suv yetkazib berish uchun mijoz va kuryer ilovalari"},"year":{"en":"2026","ru":"2026","uz":"2026"},"role":{"en":"Product Designer · Contract (SUV OL)","ru":"Продуктовый дизайнер · Контракт (SUV OL)","uz":"Product dizayner · Shartnoma (SUV OL)"},"platform":{"en":"iOS & Android","ru":"iOS и Android","uz":"iOS va Android"},"scope":{"en":"2 apps · 50+ screens","ru":"2 приложения · 50+ экранов","uz":"2 ta ilova · 50+ ekran"},"summary":{"en":"Two connected apps designed in a month — an order moves from checkout to delivery inside one system.","ru":"Два связанных приложения за месяц — заказ проходит путь от оформления до доставки в одной системе.","uz":"Bir oyda loyihalangan ikkita bog‘langan ilova — buyurtma rasmiylashtirishdan yetkazib berishgacha bitta tizimda o‘tadi."},"description":{"en":"A water delivery service with a client app for ordering and a courier app for orders, clients and promotions. I linked the two scenarios so order statuses match on both sides, and handed both apps to development with every screen state ready.","ru":"Сервис доставки воды: клиентское приложение для заказа и курьерское — для заказов, клиентов и акций. Связал сценарии клиента и курьера, чтобы статусы заказа совпадали на обеих сторонах, и передал оба приложения в разработку с готовыми состояниями экранов.","uz":"Suv yetkazib berish xizmati: buyurtma berish uchun mijoz ilovasi va buyurtmalar, mijozlar hamda aksiyalar uchun kuryer ilovasi. Mijoz va kuryer ssenariylarini bog‘ladim — buyurtma statuslari ikkala tomonda bir xil ko‘rinadi. Ikkala ilovani barcha ekran holatlari tayyor holda ishlab chiqishga topshirdim."},"highlights":[{"en":"Client app: address, catalog, checkout and order tracking","ru":"Клиент: адрес, каталог, оформление и отслеживание заказа","uz":"Mijoz ilovasi: manzil, katalog, rasmiylashtirish va buyurtmani kuzatish"},{"en":"Courier app: orders and delivery, clients, archive and promotions","ru":"Курьер: заказы и доставка, клиенты, архив и акции","uz":"Kuryer ilovasi: buyurtmalar va yetkazish, mijozlar, arxiv va aksiyalar"},{"en":"Order statuses that stay in sync between client and courier","ru":"Статусы заказа синхронизированы между клиентом и курьером","uz":"Buyurtma statuslari mijoz va kuryer o‘rtasida sinxron"},{"en":"Both apps designed in a month, handed off with complete states","ru":"Оба приложения за месяц, переданы со всеми состояниями","uz":"Ikkala ilova bir oyda loyihalandi va barcha holatlari bilan topshirildi"}],"tags":["iOS","Android","Delivery"],"accent":"#3D8BFF","cover":{"src":"/work/waterx/overview.webp","w":2400,"h":1350,"caption":{"en":"Water X — overview","ru":"Water X — обзор","uz":"Water X — umumiy ko‘rinish"}},"gallery":[{"src":"/work/waterx/client-catalog.webp","w":2400,"h":989,"caption":{"en":"Client · Catalog & checkout","ru":"Клиент · Каталог и оформление","uz":"Mijoz · Katalog va rasmiylashtirish"}},{"src":"/work/waterx/client-tracking.webp","w":2400,"h":920,"caption":{"en":"Client · Orders & tracking","ru":"Клиент · Заказы и отслеживание","uz":"Mijoz · Buyurtmalar va kuzatish"}},{"src":"/work/waterx/courier-orders.webp","w":2400,"h":740,"caption":{"en":"Courier · Orders & delivery","ru":"Курьер · Заказы и доставка","uz":"Kuryer · Buyurtmalar va yetkazish"}}]},"next":{"slug":"uysot-reports","name":"UYSOT Reports","kind":"saas","category":{"en":"SaaS · Reporting","ru":"SaaS · Отчётность","uz":"SaaS · Hisobotlar"},"title":{"en":"No-code report builder for sales teams","ru":"No-code конструктор отчётов для отделов продаж","uz":"Savdo bo‘limlari uchun no-code hisobot konstruktori"},"year":{"en":"2023 — present","ru":"2023 — н.в.","uz":"2023 — hozir"},"role":{"en":"Product Designer","ru":"Продуктовый дизайнер","uz":"Product dizayner"},"platform":{"en":"Web app","ru":"Веб-приложение","uz":"Veb-ilova"},"scope":{"en":"Builder · Formulas · Plan vs. fact","ru":"Конструктор · Формулы · План/факт","uz":"Konstruktor · Formulalar · Reja/fakt"},"summary":{"en":"Custom columns, filters, formulas and plan-vs-fact tracking — reports without asking a developer.","ru":"Свои колонки, фильтры, формулы и план/факт — отчёты без помощи разработчика.","uz":"O‘z ustunlari, filtrlar, formulalar va reja/fakt — dasturchisiz hisobotlar."},"description":{"en":"Sales managers create their own reports: pick a data source, add columns and filters, write formulas and compare plan with fact per manager. The builder keeps a complex data model approachable for non-technical users.","ru":"Менеджеры продаж сами создают отчёты: выбирают источник данных, добавляют колонки и фильтры, пишут формулы и сравнивают план с фактом по каждому менеджеру. Конструктор делает сложную модель данных понятной для нетехнических пользователей.","uz":"Savdo menejerlari hisobotlarni o‘zlari yaratadi: ma’lumot manbasini tanlaydi, ustun va filtrlar qo‘shadi, formulalar yozadi va har bir menejer bo‘yicha rejani fakt bilan solishtiradi. Konstruktor murakkab ma’lumotlar modelini texnik bo‘lmagan foydalanuvchilar uchun tushunarli qiladi."},"highlights":[{"en":"Column builder with data sources, measures and filters","ru":"Конструктор колонок: источники данных, показатели и фильтры","uz":"Ustunlar konstruktori: ma’lumot manbalari, ko‘rsatkichlar va filtrlar"},{"en":"Formulas and grouping by manager or source","ru":"Формулы и группировка по менеджеру или источнику","uz":"Formulalar va menejer yoki manba bo‘yicha guruhlash"},{"en":"Plan vs. fact tables for sales teams","ru":"Таблицы план/факт для отделов продаж","uz":"Savdo bo‘limlari uchun reja/fakt jadvallari"}],"tags":["Web app","Reporting","Tables"],"accent":"#1FB5A0","cover":{"src":"/work/reports/overview.webp","w":2400,"h":1350,"caption":{"en":"UYSOT Reports — overview","ru":"UYSOT Reports — обзор","uz":"UYSOT Reports — umumiy ko‘rinish"}},"gallery":[{"src":"/work/reports/02-builder.webp","w":2400,"h":2168,"caption":{"en":"Custom report builder","ru":"Конструктор отчётов","uz":"Hisobot konstruktori"}}]}}],"$L4"]}],["$L5","$L6"],"$L7"]}],"loading":null,"isPartial":false}
