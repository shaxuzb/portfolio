5:["$","main",null,{"children":[["$","$L12",null,{}],["$","$L13",null,{"project":{"slug":"base360","name":"Base360","kind":"web","category":{"en":"Web · Landing page","ru":"Веб · Лендинг","uz":"Veb · Landing sahifa"},"title":{"en":"Landing page and base360.ai improvement","ru":"Лендинг и улучшение base360.ai","uz":"Landing sahifa va base360.ai’ni yaxshilash"},"year":{"en":"2026","ru":"2026","uz":"2026"},"role":{"en":"Product Designer · Test assignment","ru":"Продуктовый дизайнер · Тестовое задание","uz":"Product dizayner · Test topshiriq"},"platform":{"en":"Desktop 1440 · Tablet 810 · Mobile 390","ru":"Десктоп 1440 · Планшет 810 · Мобайл 390","uz":"Desktop 1440 · Planshet 810 · Mobil 390"},"scope":{"en":"12 screens · 32 components","ru":"12 экранов · 32 компонента","uz":"12 ekran · 32 komponent"},"summary":{"en":"A responsive landing page from a brief, plus a redesign proposal for base360.ai — in light and dark.","ru":"Адаптивный лендинг по ТЗ и предложения по редизайну base360.ai — в светлой и тёмной темах.","uz":"Texnik topshiriq bo‘yicha moslashuvchan landing va base360.ai uchun redizayn takliflari — yorug‘ va qorong‘i mavzuda."},"description":{"en":"A test assignment: a landing page designed from the brief across desktop, tablet and mobile, a case study improving the existing base360.ai, and the foundations and UI kit behind both — 32 components in light and dark modes.","ru":"Тестовое задание: лендинг по ТЗ для десктопа, планшета и мобайла, кейс с улучшениями текущего base360.ai, а также foundations и UI kit — 32 компонента в светлой и тёмной темах.","uz":"Test topshiriq: desktop, planshet va mobil uchun texnik topshiriq bo‘yicha landing, mavjud base360.ai’ni yaxshilash bo‘yicha keys, hamda ularning asosi — foundations va UI kit: yorug‘ va qorong‘i mavzudagi 32 ta komponent."},"highlights":[{"en":"Responsive layouts for 1440, 810 and 390","ru":"Адаптивные макеты под 1440, 810 и 390","uz":"1440, 810 va 390 uchun moslashuvchan maketlar"},{"en":"Case study with proposed improvements to base360.ai","ru":"Кейс с предложениями по улучшению base360.ai","uz":"base360.ai’ni yaxshilash bo‘yicha takliflar bilan keys"},{"en":"Foundations and a 32-component UI kit in light and dark","ru":"Foundations и UI kit из 32 компонентов в двух темах","uz":"Ikki mavzudagi foundations va 32 komponentli UI kit"}],"tags":["Web","Landing","UI kit"],"accent":"#8BE35F","cover":{"src":"/work/base360/overview.webp","w":2400,"h":1350,"caption":{"en":"Base360 — overview","ru":"Base360 — обзор","uz":"Base360 — umumiy ko‘rinish"}},"gallery":[{"src":"/work/base360/01-highlights.webp","w":2400,"h":1535,"caption":{"en":"Highlights","ru":"Ключевые моменты","uz":"Asosiy jihatlar"}},{"src":"/work/base360/02-desktop.webp","w":1800,"h":4417,"caption":{"en":"Desktop · 1440","ru":"Десктоп · 1440","uz":"Desktop · 1440"}},{"src":"/work/base360/05-case.webp","w":1800,"h":4683,"caption":{"en":"Case study","ru":"Кейс","uz":"Keys"}},{"src":"/work/base360/06-foundations.webp","w":1800,"h":2735,"caption":{"en":"Foundations","ru":"Foundations","uz":"Foundations"}}]},"next":{"slug":"uyqur","name":"UYQUR","kind":"saas","category":{"en":"SaaS · Construction ERP","ru":"SaaS · Строительная ERP","uz":"SaaS · Qurilish ERP"},"title":{"en":"All-in-one platform for construction companies","ru":"Единая платформа для строительных компаний","uz":"Qurilish kompaniyalari uchun yagona platforma"},"year":{"en":"2024 — present","ru":"2024 — н.в.","uz":"2024 — hozir"},"role":{"en":"Product Designer","ru":"Продуктовый дизайнер","uz":"Product dizayner"},"platform":{"en":"Web app","ru":"Веб-приложение","uz":"Veb-ilova"},"scope":{"en":"16 modules · AI assistant","ru":"16 модулей · ИИ-ассистент","uz":"16 modul · AI yordamchi"},"summary":{"en":"Estimates, supply and tenders, cash, warehouse, works and analytics for construction companies — in one web platform.","ru":"Сметы, снабжение и тендеры, касса, склад, работы и аналитика для строительных компаний — в одной веб-платформе.","uz":"Smetalar, ta’minot va tenderlar, kassa, ombor, ishlar va analitika — qurilish kompaniyalari uchun bitta veb-platformada."},"description":{"en":"UYQUR is a SaaS for managing construction projects. I own the product design end-to-end on web and mobile, turning dense business requirements into interfaces that people in very different roles — site managers, accountants, supply, owners — can work in every day. Each module is worked through for every role and edge case before it goes to development.","ru":"UYQUR — SaaS для управления строительными проектами. Веду дизайн продукта end-to-end на вебе и мобайле: превращаю сложные бизнес-требования в интерфейсы, в которых каждый день работают люди с очень разными ролями — прорабы, бухгалтеры, снабжение, владельцы. Каждый модуль прорабатываю под все роли и edge cases до передачи в разработку.","uz":"UYQUR — qurilish loyihalarini boshqarish uchun SaaS. Veb va mobilda mahsulot dizaynini boshidan oxirigacha olib boraman: murakkab biznes-talablarni turli roldagi odamlar — prorablar, buxgalterlar, ta’minotchilar, egalar — har kuni ishlaydigan interfeyslarga aylantiraman. Har bir modulni ishlab chiqishga berishdan oldin barcha rollar va edge case’lar bo‘yicha ishlab chiqaman."},"highlights":[{"en":"Translated complex business requirements into clear interfaces for multi-role teams","ru":"Перевёл сложные бизнес-требования в понятные интерфейсы для многоролевых команд","uz":"Murakkab biznes-talablarni ko‘p rolli jamoalar uchun tushunarli interfeyslarga aylantirdim"},{"en":"Designed 16 modules: projects, estimates, supply & tenders, cash, warehouse, contracts and more","ru":"Спроектировал 16 модулей: проекты, сметы, снабжение и тендеры, касса, склад, договоры и другие","uz":"16 ta modulni loyihaladim: loyihalar, smetalar, ta’minot va tenderlar, kassa, ombor, shartnomalar va boshqalar"},{"en":"Nura — an AI assistant built into the product","ru":"Nura — ИИ-ассистент внутри продукта","uz":"Nura — mahsulot ichidagi AI yordamchi"},{"en":"Moved web scenarios to mobile with the same logic, so the product works from a phone","ru":"Перенёс веб-сценарии на мобайл с единой логикой — с продуктом можно работать с телефона","uz":"Veb-ssenariylarni yagona mantiq bilan mobilga ko‘chirdim — mahsulot bilan telefondan ishlash mumkin"}],"tags":["Web app","ERP","Dashboards","AI"],"accent":"#6F7CFF","featured":true,"cover":{"src":"/work/uyqur/overview.webp","w":2400,"h":1350,"caption":{"en":"UYQUR — overview","ru":"UYQUR — обзор","uz":"UYQUR — umumiy ko‘rinish"}},"gallery":[{"src":"/work/uyqur/02-dashboards.webp","w":1800,"h":3988,"caption":{"en":"Dashboards","ru":"Дашборды","uz":"Dashboardlar"}},{"src":"/work/uyqur/03-projects.webp","w":2400,"h":1662,"caption":{"en":"Projects","ru":"Проекты","uz":"Loyihalar"}},{"src":"/work/uyqur/07-finance.webp","w":2400,"h":3262,"caption":{"en":"Cash & finance","ru":"Касса и финансы","uz":"Kassa va moliya"}},{"src":"/work/uyqur/13-ai.webp","w":2400,"h":2582,"caption":{"en":"Nura AI assistant","ru":"ИИ-ассистент Nura","uz":"Nura AI yordamchi"}}]}}],"$L14"]}]
