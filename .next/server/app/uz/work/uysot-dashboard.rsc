5:["$","main",null,{"children":[["$","$L12",null,{}],["$","$L13",null,{"project":{"slug":"uysot-dashboard","name":"UYSOT Dashboard","kind":"saas","category":{"en":"SaaS · Analytics","ru":"SaaS · Аналитика","uz":"SaaS · Analitika"},"title":{"en":"Customizable sales & marketing dashboards","ru":"Настраиваемые дашборды продаж и маркетинга","uz":"Sozlanadigan savdo va marketing dashboardlari"},"year":{"en":"2023 — present","ru":"2023 — н.в.","uz":"2023 — hozir"},"role":{"en":"Product Designer","ru":"Продуктовый дизайнер","uz":"Product dizayner"},"platform":{"en":"Web & mobile","ru":"Веб и мобайл","uz":"Veb va mobil"},"scope":{"en":"Widget library · Funnels","ru":"Библиотека виджетов · Воронки","uz":"Vidjetlar kutubxonasi · Voronkalar"},"summary":{"en":"Sales and marketing dashboards for real-estate developers, assembled from a responsive widget library.","ru":"Дашборды продаж и маркетинга для девелоперов, собранные из адаптивной библиотеки виджетов.","uz":"Developerlar uchun moslashuvchan vidjetlar kutubxonasidan yig‘iladigan savdo va marketing dashboardlari."},"description":{"en":"Managers build their own dashboard pages from a library of widgets — KPIs, funnels, campaign breakdowns and conversion trends. The widgets are designed once and adapt to any grid size and to mobile.","ru":"Менеджеры сами собирают страницы дашбордов из библиотеки виджетов — KPI, воронки, разбивка по кампаниям и динамика конверсии. Виджеты спроектированы один раз и адаптируются к любой сетке и к мобайлу.","uz":"Menejerlar dashboard sahifalarini vidjetlar kutubxonasidan o‘zlari yig‘adi — KPI, voronkalar, kampaniyalar kesimi va konversiya dinamikasi. Vidjetlar bir marta loyihalangan va istalgan to‘r o‘lchamiga hamda mobilga moslashadi."},"highlights":[{"en":"Sales dashboards with KPIs, funnels and conversion over time","ru":"Дашборды продаж: KPI, воронки и динамика конверсии","uz":"Savdo dashboardlari: KPI, voronkalar va konversiya dinamikasi"},{"en":"Editable dashboard pages managers assemble themselves","ru":"Редактируемые страницы, которые менеджеры собирают сами","uz":"Menejerlar o‘zlari yig‘adigan tahrirlanuvchi sahifalar"},{"en":"Responsive widget library that scales from desktop to mobile","ru":"Адаптивная библиотека виджетов — от десктопа до мобайла","uz":"Desktopdan mobilgacha moslashuvchan vidjetlar kutubxonasi"}],"tags":["Web app","Analytics","Widgets"],"accent":"#34C38F","cover":{"src":"/work/dashboard/overview.webp","w":2400,"h":1350,"caption":{"en":"UYSOT Dashboard — overview","ru":"UYSOT Dashboard — обзор","uz":"UYSOT Dashboard — umumiy ko‘rinish"}},"gallery":[{"src":"/work/dashboard/01-sales.webp","w":2400,"h":1808,"caption":{"en":"Sales dashboards","ru":"Дашборды продаж","uz":"Savdo dashboardlari"}},{"src":"/work/dashboard/04-widgets.webp","w":2400,"h":1961,"caption":{"en":"Widget library","ru":"Библиотека виджетов","uz":"Vidjetlar kutubxonasi"}}]},"next":{"slug":"water-x","name":"Water X","kind":"mobile","category":{"en":"Mobile apps · Water delivery","ru":"Мобильные приложения · Доставка воды","uz":"Mobil ilovalar · Suv yetkazib berish"},"title":{"en":"Client and courier apps for water delivery","ru":"Клиентское и курьерское приложения для доставки воды","uz":"Suv yetkazib berish uchun mijoz va kuryer ilovalari"},"year":{"en":"2026","ru":"2026","uz":"2026"},"role":{"en":"Product Designer · Contract (SUV OL)","ru":"Продуктовый дизайнер · Контракт (SUV OL)","uz":"Product dizayner · Shartnoma (SUV OL)"},"platform":{"en":"iOS & Android","ru":"iOS и Android","uz":"iOS va Android"},"scope":{"en":"2 apps · 50+ screens","ru":"2 приложения · 50+ экранов","uz":"2 ta ilova · 50+ ekran"},"summary":{"en":"Two connected apps designed in a month — an order moves from checkout to delivery inside one system.","ru":"Два связанных приложения за месяц — заказ проходит путь от оформления до доставки в одной системе.","uz":"Bir oyda loyihalangan ikkita bog‘langan ilova — buyurtma rasmiylashtirishdan yetkazib berishgacha bitta tizimda o‘tadi."},"description":{"en":"A water delivery service with a client app for ordering and a courier app for orders, clients and promotions. I linked the two scenarios so order statuses match on both sides, and handed both apps to development with every screen state ready.","ru":"Сервис доставки воды: клиентское приложение для заказа и курьерское — для заказов, клиентов и акций. Связал сценарии клиента и курьера, чтобы статусы заказа совпадали на обеих сторонах, и передал оба приложения в разработку с готовыми состояниями экранов.","uz":"Suv yetkazib berish xizmati: buyurtma berish uchun mijoz ilovasi va buyurtmalar, mijozlar hamda aksiyalar uchun kuryer ilovasi. Mijoz va kuryer ssenariylarini bog‘ladim — buyurtma statuslari ikkala tomonda bir xil ko‘rinadi. Ikkala ilovani barcha ekran holatlari tayyor holda ishlab chiqishga topshirdim."},"highlights":[{"en":"Client app: address, catalog, checkout and order tracking","ru":"Клиент: адрес, каталог, оформление и отслеживание заказа","uz":"Mijoz ilovasi: manzil, katalog, rasmiylashtirish va buyurtmani kuzatish"},{"en":"Courier app: orders and delivery, clients, archive and promotions","ru":"Курьер: заказы и доставка, клиенты, архив и акции","uz":"Kuryer ilovasi: buyurtmalar va yetkazish, mijozlar, arxiv va aksiyalar"},{"en":"Order statuses that stay in sync between client and courier","ru":"Статусы заказа синхронизированы между клиентом и курьером","uz":"Buyurtma statuslari mijoz va kuryer o‘rtasida sinxron"},{"en":"Both apps designed in a month, handed off with complete states","ru":"Оба приложения за месяц, переданы со всеми состояниями","uz":"Ikkala ilova bir oyda loyihalandi va barcha holatlari bilan topshirildi"}],"tags":["iOS","Android","Delivery"],"accent":"#3D8BFF","cover":{"src":"/work/waterx/overview.webp","w":2400,"h":1350,"caption":{"en":"Water X — overview","ru":"Water X — обзор","uz":"Water X — umumiy ko‘rinish"}},"gallery":[{"src":"/work/waterx/client-catalog.webp","w":2400,"h":989,"caption":{"en":"Client · Catalog & checkout","ru":"Клиент · Каталог и оформление","uz":"Mijoz · Katalog va rasmiylashtirish"}},{"src":"/work/waterx/client-tracking.webp","w":2400,"h":920,"caption":{"en":"Client · Orders & tracking","ru":"Клиент · Заказы и отслеживание","uz":"Mijoz · Buyurtmalar va kuzatish"}},{"src":"/work/waterx/courier-orders.webp","w":2400,"h":740,"caption":{"en":"Courier · Orders & delivery","ru":"Курьер · Заказы и доставка","uz":"Kuryer · Buyurtmalar va yetkazish"}}]}}],"$L14"]}]
