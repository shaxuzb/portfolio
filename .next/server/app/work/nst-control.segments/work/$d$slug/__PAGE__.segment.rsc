26","role":"Web & Mobile Developer","summary":"Sales, stock, finance and staff in one connected system across web, mobile, the till and a Telegram Mini App.","description":"Daqiq is an ERP and business operations platform built for retail stores, warehouses, and sales teams. I worked across the web and mobile product, implementing finance dashboards, inventory workflows, product traceability, employee control, sales and purchasing flows, reporting, responsive UI, API integrations, state management, and mobile business views. The platform brings core operations into one connected ecosystem across web, mobile, and Telegram.","highlights":["Finance dashboards: net profit, cash and stock on one screen","Inventory, purchasing and product traceability workflows","Employee control and role-based reporting","One ecosystem across web, mobile and Telegram Mini App"],"stack":["React","Next.js","React Native","TypeScript"],"platforms":["Web","Mobile","Telegram Mini App"],"metric":{"value":"4 / 5","label":"companies / stores in production"},"live":"https://daqiq.uz","accent":"#7C4DFF","cover":"/work/daqiq/cover.webp","gallery":[{"src":"/work/daqiq/1.webp","w":1600,"h":1200},{"src":"/work/daqiq/2.webp","w":1600,"h":1200},{"src":"/work/daqiq/3.webp","w":1600,"h":1200},{"src":"/work/daqiq/4.webp","w":1600,"h":1200},{"src":"/work/daqiq/5.webp","w":1600,"h":1200},{"src":"/work/daqiq/6.webp","w":1600,"h":1200},{"src":"/work/daqiq/7.webp","w":1600,"h":1200},{"src":"/work/daqiq/8.webp","w":1600,"h":1200},{"src":"/work/daqiq/9.webp","w":1600,"h":1200}]}}],["$","$L4",null,{}]]}],[["$","script","script-0",{"src":"/_next/static/chunks/4a9442b17c6f9034.js","async":true}],["$","script","script-1",{"src":"/_next/static/chunks/b758b8c1fa4e20cc.js","async":true}]],["$","$L5",null,{"children":["$","$6",null,{"name":"Next.MetadataOutlet","children":"$@7"}]}]]}],"loading":null,"isPartial":false}
